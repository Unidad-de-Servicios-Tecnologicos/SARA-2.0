# ========================================
# CONFIGURACIÓN DE SARA FRONTEND
# ========================================
# Copie este archivo como .env y configure los valores

# ========================================
# API BACKEND
# ========================================

# URL base del API de SARA
# En desarrollo: http://localhost:3000/api
# En producción: https://api.sara.sena.edu.co
VITE_API_URL=http://localhost:3000/api

# Timeout para peticiones HTTP (en milisegundos)
VITE_API_TIMEOUT=30000

# Usar datos mock (true/false)
# En desarrollo: true (usa datos simulados)
# En producción: false (usa API real)
VITE_USE_MOCK=true

# ========================================
# AUTENTICACIÓN
# ========================================

# Tiempo de expiración del token (en segundos)
VITE_TOKEN_EXPIRY=3600

# ========================================
# APLICACIÓN
# ========================================

# Nombre de la aplicación
VITE_APP_NAME=SARA

# Versión de la aplicación
VITE_APP_VERSION=1.0.0

# Modo de la aplicación (development, staging, production)
VITE_APP_MODE=development

# ========================================
# CARACTERÍSTICAS (Feature Flags)
# ========================================

# Habilitar módulo de prácticas
VITE_FEATURE_PRACTICES=true

# Habilitar generación de documentos con IA
VITE_FEATURE_AI_DOCUMENTS=true

# Habilitar reserva de ambientes con QR
VITE_FEATURE_QR_BOOKING=false

# ========================================
# ANALYTICS (Opcional)
# ========================================

# ID de Google Analytics
# VITE_GA_ID=G-XXXXXXXXXX

# ========================================
# OTROS
# ========================================

# Intervalo de auto-refresh del dashboard (en milisegundos)
VITE_DASHBOARD_REFRESH_INTERVAL=300000
